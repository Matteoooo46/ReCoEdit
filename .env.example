# Environment variables for ReCoEdit training/inference.
# Copy to .env and fill in your own values:
#   cp .env.example .env
#   source .env

# WandB API key — required if you use --report_to wandb during training.
# Get one at https://wandb.ai/settings
export WANDB_API_KEY=your_wandb_api_key_here

# URL of your VLM reward server (Qwen3-VL-30B served via vLLM).
# Used by the product_consistency reward during RL training.
export RECOEDIT_VLM_URL=http://localhost:8080/v1
